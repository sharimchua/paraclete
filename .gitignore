# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Environment & IDE
.env
.DS_Store
.vscode/

# Database files
*.db
*.db-shm
*.db-wal

# Obsidian local workspace, transient UI states & cache
.obsidian/workspace*.json
vault/.obsidian/workspace*.json
