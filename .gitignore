config.yaml

# PRIVATE VAULT CONTENT (Strictly ignored from version control)
vault/input/**
vault/okf/**
vault/output/**
!vault/input/**/
!vault/okf/**/
!vault/output/**/
!vault/**/.gitkeep
!vault/**/AGENTS.md
